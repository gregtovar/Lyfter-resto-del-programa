Algoritmo 2\
=====================\
\
\
 \
\
ALGORITMO Rutina_Diaria_de_Greg;\
\
//\
// Trate de hacerlo como un programa tipo psuedo lenguaje\
//\
\
\
//Declaracion de Variables \
\
Variables;\
  dia_activo = true\
  nivel_de_energia =80\
  apetito = 30\
  nivel_de_stress = 20\
  hora = 630AM\
\
\
	//\
	// Levantarse\
	//\
    \
    SI hora = 06:30 ENTONCES\
      LEVANTARSE()\
      TOMAR_AGUA()\
      nivel_de_energia =  nivel_de_energia + 5\
      ivel_de_stress =  =  nivel_de_stress - 5\
    FIN_SI\
\
\
    \
    SI (nivel_de_energia >= 50) Y (hora >= 07:00) Y (hora <= 08:00) ENTONCES\
      HACER_EJERCICIO(30_min)\
      nivel_de_energia  =   nivel_de_energia - 20\
      apetito =   apetito + 25\
      nivel_de_stress  =   nivel_de_stress - 10\
    SINO\
      CAMINAR(10_min)\
      nivel_de_energia  =   nivel_de_energia - 5\
      apetito =   apetito+ 10\
    FIN_SI\
\
    \
    SI hora >= 07:30 Y hora <= 09:00 ENTONCES\
      BA\'d1ARSE()\
      VESTIRSE()\
    FIN_SI\
\
	//\
    // \'97\'97  DESAYUNO\
	//\
    SI apetito>= 50 ENTONCES\
      COMER("desayuno")\
      apetito =   apetito- 40\
      nivel_de_energia  =   nivel_de_energia + 10\
    FIN_SI\
\
	//\
    // \'97\'97\'97 TRABAJO \
	//\
    SI hora >= 09:00 Y hora < 17:00 ENTONCES\
\
      PARA bloque DESDE 1 HASTA 4 HACER\
        TRABAJAR(90_min)\
        nivel_de_stress  =    nivel_de_stress + 10\
        nivel_de_energia  =   nivel_de_energia - 10\
        apetito =   apetito + 10\
\
		//\
        // \'97\'97\'97\'97\'97 Descanso  \
		//\
        SI nivel_de_energia < 30 O  =  nivel_de_stress > 70 ENTONCES\
          DESCANSAR(15_min)\
          RESPIRAR()\
          nivel_de_energia  =   nivel_de_energia + 10\
          nivel_de_stress =  nivel_de_stress - 15\
        SINO\
          DESCANSAR(5_min)\
          nivel_de_energia  =   nivel_de_energia + 5\
        FIN_SI\
      FIN_PARA\
\
\
      //\
	  // Almuerzo - Cominda de Medio dia\
      //\
      SI (hora >= 12:00 Y hora <= 14:00) Y (apetito>= 50) ENTONCES\
        COMER("almuerzo")\
        apetito =   apetito- 50\
        nivel_de_energia  =   nivel_de_energia + 15\
       nivel_de_stress  =    =  nivel_de_stress - 5\
      FIN_SI\
\
    FIN_SI\
\
\
    //\
	// Amigos\
    //    \
      SI hora >= 17:30 Y hora <= 20:30 ENTONCES\
      SI ( =  nivel_de_stress >= 60) O (hoy_es("fin_de_semana") = VERDADERO) ENTONCES\
        HABLAR_CON_AMIGOS("llamada o chat", 20_min)\
         nivel_de_stress     =  nivel_de_stress - 20\
        nivel_de_energia  =   nivel_de_energia + 5\
      FIN_SI\
    FIN_SI\
\
    // \
	// CENA\
	//\
    SI hora >= 19:00 Y apetito>= 50 ENTONCES\
      COMER("cena")\
      apetito =   apetito- 50\
      nivel_de_energia  =   nivel_de_energia + 10\
    FIN_SI\
\
    // \
	// RELAX Y VER TV\
	//\
\
    SI hora >= 20:00 Y hora <= 22:30 ENTONCES\
      episodios  =   0\
      MIENTRAS episodios < 2 Y nivel_de_energia > 15 HACER\
        VER_TV(1_episodio)\
        episodios  =   episodios + 1\
        nivel_de_energia  =   nivel_de_energia - 10\
      FIN_MIENTRAS\
    FIN_SI\
\
	//\
    // Terminar el dia\
	//\
\
    SI hora >= 22:30 O nivel_de_energia <= 10 ENTONCES\
      PREPARAR_DIA_SIGUIENTE()\
      APAGAR_PANTALLAS()\
      DORMIR()\
      dia_activo  =   false;\
    FIN_SI\
\
  FIN_MIENTRAS\
\
FIN\
